# CloudFront（VPC origin）からだけ受ける HTTP のリバースプロキシ（TLS は CloudFront で終わる。証明書は CloudFront の標準のもの: I-050）。
# 多層の防御（EC2 の SG で CloudFront の VPC origin の管理 SG からだけ受けたうえで）:
# - CloudFront が付ける合言葉（X-Origin-Verify）が無い・違う要求は 403（直接の接続・別の経路を拒否）。合言葉は上流へ渡さない。
# - Host は公開 URL（d*.cloudfront.net）だけ。違えば 421。
# - パスが紛らわしい要求（`;`・`\`・`/./`・`/../`・`%2e`・`%2f`・`%5c`・`%3b`・`%25`・`%00`）は 400。Caddy の経路の一致は整えた後のパスで行い、上流へは
#   元のパスを渡すため、`/v1/agent/..;/internal/…` のような要求で /internal の遮断を迂回させない（レビュー A1。クエリは対象外）。
# - クライアントが付けられる利用者・認証の識別のヘッダは捨てる（アプリは Authorization の ID トークンの署名を検証する。oauth2-proxy が付け直す）。
#   X-Forwarded-*・X-Auth-Request-*・Forwarded・X-Real-Ip も捨てる（oauth2-proxy の --reverse-proxy が戻り先・IP に使うため。レビュー A2）。
# - 上流には「HTTPS で受けた」と伝える（X-Forwarded-Proto: https。Cookie の Secure・戻り先の URL・CSRF の Origin の検査が公開 URL と一致する）。
# 経路（route の中は書いた順に評価する。Caddy の既定の順序では respond が handle より後になるため route を使う）:
# - /internal は外へ出さない（404）。/_jrabot/health は CloudFront 経由の準備完了の確認（中身は ok だけ）。
# - /logout は oauth2-proxy の sign_out → Cognito のログアウト → 公開 URL の / に戻る。
# - /v1/agent/* は Windows 取得エージェント → ingest（認証はエージェントのトークンの HMAC。人のログイン画面は返さない）。
# - それ以外は oauth2-proxy（Cognito でログイン・本人のメールだけ）→ dashboard（Cognito の ID トークンの署名・本人の許可をアプリが検証する）。
# 結合試験: infra の ops/it/caddy-edge.mjs（CI の aws-edge）。
{
	admin off
	auto_https off
	servers {
		protocols h1
	}
}

:80 {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		?Cache-Control "no-store"
		-Server
	}
	route {
		@foreign not header X-Origin-Verify {$ORIGIN_VERIFY}
		respond @foreign 403 {
			close
		}
		@wronghost not host {$SITE_HOST}
		respond @wronghost 421
		@badpath vars_regexp {http.request.uri} (?i)^[^?]*(;|\\|%2e|%2f|%5c|%3b|%25|%00|/\.\.?(/|$))
		respond @badpath 400

		request_header -X-Origin-Verify
		request_header -X-Forwarded-*
		request_header -X-Auth-Request-*
		request_header -Forwarded
		request_header -X-Real-Ip
		request_header -X-Goog-Iap-Jwt-Assertion
		request_header -X-Goog-Authenticated-User-Email
		request_header -X-Goog-Authenticated-User-Id

		@internal path /internal /internal/*
		respond @internal 404
		respond /_jrabot/health "ok" 200
		redir /logout /oauth2/sign_out?rd={$LOGOUT_TARGET} 302

		reverse_proxy /v1/agent/* jrabot-ingest:8080 {
			header_up Host {host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
		}
		reverse_proxy jrabot-oauth2-proxy:4180 {
			header_up Host {host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
		}
	}
}
