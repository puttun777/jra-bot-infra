{
  "name": "jra-bot-infra",
  "private": true,
  "description": "運用 CLI（ops/）と GCP の資源定義（Pulumi。pulumi/）の TypeScript。jra-bot-web の docs/LANGUAGE_MIGRATION.md",
  "type": "module",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "build": "tsc -p ops/tsconfig.json && tsc -p pulumi/tsconfig.json",
    "lint": "biome check ops pulumi",
    "format": "biome check --write ops pulumi",
    "test": "npm run --silent build && node ops/run-tests.mjs && node pulumi/run-tests.mjs",
    "ops": "node build/ops/src/cli.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@pulumi/gcp": "10.2.0",
    "@pulumi/pulumi": "3.270.0",
    "ajv": "8.20.0",
    "zod": "4.6.7"
  }
}
